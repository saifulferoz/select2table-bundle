<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
               https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <defaults autowire="false" autoconfigure="false" public="false" />

        <service id="SaifulFeroz\Select2TableBundle\Form\Type\Select2TableType"
                 class="SaifulFeroz\Select2TableBundle\Form\Type\Select2TableType">
            <argument type="service" id="doctrine.dbal.default_connection" on-invalid="null" />
            <argument type="service" id="router" />
            <argument>%saifulferoz_select2_table.config%</argument>
            <tag name="form.type" />
        </service>

        <service id="SaifulFeroz\Select2TableBundle\Service\AutocompleteService"
                 class="SaifulFeroz\Select2TableBundle\Service\AutocompleteService"
                 public="true">
            <argument type="service" id="form.factory" />
            <argument type="service" id="doctrine.dbal.default_connection" on-invalid="null" />
        </service>

        <!-- Aliases for backward compatibility -->
        <service id="feroz_select2table.select2table_type" alias="SaifulFeroz\Select2TableBundle\Form\Type\Select2TableType" public="true" />
        <service id="feroz_select2table.autocomplete_service" alias="SaifulFeroz\Select2TableBundle\Service\AutocompleteService" public="true" />
        <service id="saifulferoz_select2table.autocomplete_service" alias="SaifulFeroz\Select2TableBundle\Service\AutocompleteService" public="true" />
        <service id="Feroz\Select2TableBundle\Form\Type\Select2TableType" alias="SaifulFeroz\Select2TableBundle\Form\Type\Select2TableType" public="true" />
        <service id="Feroz\Select2TableBundle\Service\AutocompleteService" alias="SaifulFeroz\Select2TableBundle\Service\AutocompleteService" public="true" />
    </services>
</container>
